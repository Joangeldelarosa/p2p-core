{
  "name": "p2p-core",
  "version": "0.1.0",
  "description": "WebRTC-based P2P library: rooms, signaling, chat, relay fallback",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src server --ext .ts",
    "server": "ts-node server/index.ts",
    "server:dev": "ts-node-dev --respawn server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "peer-to-peer",
    "signaling",
    "datachannel",
    "chat",
    "real-time"
  ],
  "author": "Joangeldelarosa",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
